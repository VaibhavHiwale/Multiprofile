{
  "name": "multiprofile",
  "version": "1.0.0",
  "description": "MultiProfile — Stremio multi-profile manager on Cloudflare Workers + D1 + R2 (household-scoped catalogs, no Stremio account credential ever stored)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --local",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply multiprofile-db --local"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "@cf-wasm/satori": "^0.4.0",
    "@noble/hashes": "^2.3.0",
    "hono": "^4.13.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "vitest": "~4.1.10",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
